#!/usr/bin/env bash
# Commit-msg: Conventional Commits with a Jira ticket key, e.g.
#   feat(login): add biometric unlock [REF-42]
# Rules: scripts/conventions.sh (CI checks the same rules on every pull request: scripts/ci/check-conventions.sh).
# Git-generated merge/revert subjects and fixup!/squash!/amend! commits are exempt here.
set -euo pipefail

# shellcheck source=scripts/conventions.sh
source "$(git rev-parse --show-toplevel)/scripts/conventions.sh"

subject="$(grep -vE '^\s*#' "$1" | head -n 1)"

if ! check_commit_subject "$subject" local; then
  echo "commit-msg: commit aborted — fix the message (docs/pr-workflow.md#4-commit--the-local-hooks)." >&2
  exit 1
fi
