# Template for fastlane/.env (gitignored). Copy, then fill in ONLY what you need:
#   cp fastlane/.env.example fastlane/.env
# Every variable is described in docs/secrets.md. Prefer file paths outside the repo for key files.
# In CI the same variables come from GitHub Environment secrets — never from a committed file.

# --- Apple (iOS) ---
APPLE_TEAM_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
# Local: path to the .p8 file, e.g. ~/.secrets/refproj/AuthKey_XXXXXXXXXX.p8
ASC_KEY_PATH=
# CI only (base64 of the .p8). Leave empty locally.
ASC_KEY_CONTENT_BASE64=

# --- fastlane match (iOS certificates repo) ---
MATCH_GIT_URL=https://github.com/Charlesuru/refproj-certificates.git
MATCH_PASSWORD=
# CI only: base64("<github-user>:<fine-grained PAT with read access to the certificates repo>")
MATCH_GIT_BASIC_AUTHORIZATION=

# --- Android upload key (alternatively in ~/.gradle/gradle.properties as refproj.signing.*) ---
REFPROJ_SIGNING_STORE_FILE=
REFPROJ_SIGNING_STORE_PASSWORD=
REFPROJ_SIGNING_KEY_ALIAS=
REFPROJ_SIGNING_KEY_PASSWORD=

# --- Google Play (PROD) ---
PLAY_SERVICE_ACCOUNT_FILE=

# --- Firebase App Distribution (Android DEV/SIT/STAGE). App IDs are not secret. ---
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_APP_ID_ANDROID_DEV=
FIREBASE_APP_ID_ANDROID_SIT=
FIREBASE_APP_ID_ANDROID_STAGE=
FIREBASE_TESTER_GROUPS=internal
