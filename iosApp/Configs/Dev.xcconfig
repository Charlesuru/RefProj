// DEV environment. Selected by the RefProj-Dev scheme (Debug-Dev / Release-Dev).
#include "Base.xcconfig"

APP_ENVIRONMENT = DEV
APP_BUNDLE_ID = $(APP_BASE_BUNDLE_ID).dev
APP_DISPLAY_NAME = RefProj DEV
// "//" starts a comment in xcconfig, hence the $() separator.
API_BASE_URL = https:/$()/api.dev.refproj.example
// Placeholder icon with the environment label (scripts/assets/generate-placeholder-icons.swift).
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev
// Firebase client config: iosApp/Firebase/Dev/GoogleService-Info.plist (gitignored, docs/secrets.md).
APP_FIREBASE_DIR = Dev
